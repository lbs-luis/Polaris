{
  "name": "polaris",
  "version": "0.0.1",
  "description": "Polaris — local-first finance app",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo prebuild --clean && expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "prebuild": "expo prebuild --clean",
    "build:android": "npm run prebuild && cd android && ./gradlew assembleRelease",
    "install:android": "adb install android/app/build/outputs/apk/release/app-release.apk"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --cache --write"
    ],
    "*.{js,json,md}": "prettier --cache --write --ignore-unknown"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "5.2.9",
    "@react-native-picker/picker": "2.11.4",
    "clsx": "2.1.1",
    "expo": "55.0.6",
    "expo-constants": "55.0.7",
    "expo-file-system": "55.0.16",
    "expo-image-picker": "55.0.18",
    "expo-linear-gradient": "55.0.13",
    "expo-linking": "55.0.7",
    "expo-router": "55.0.5",
    "expo-sqlite": "55.0.10",
    "expo-status-bar": "55.0.4",
    "lucide-react-native": "0.577.0",
    "nativewind": "4.2.2",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.58.2",
    "@typescript-eslint/parser": "8.58.2",
    "babel-preset-expo": "55.0.11",
    "eslint": "10.2.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-tailwindcss": "3.18.2",
    "globals": "17.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier-plugin-tailwindcss": "0.5.14",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.2",
    "typescript-eslint": "8.58.2"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
